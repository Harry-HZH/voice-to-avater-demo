# ThankYou Open API（生成形象 / 语音 / 视频的统一入口）
# 去 https://thankyouai.com/developer 注册，在控制台创建 API Key（tk_ 开头）
THANK_YOU_AI_KEY=

# 可选覆盖
# THANKYOU_BASE_URL=https://api.thankyouai.com/open/v1
# TTS_MODEL=fish-audio/text-to-speech

# MongoDB（可选）。不填或连不上会自动回退到 backend/data/store.json
# MONGO_URL=mongodb://localhost:27017
# MONGO_DB=voice_avatar

# 允许跨域的前端地址，逗号分隔；* 表示全部（仅开发用）
CORS_ORIGINS=*
